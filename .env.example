API_BASE_URL=https://your-api-domain/api

# Error + performance monitoring — sentry.io > Projects > (this project) >
# Settings > Client Keys (DSN). NEXT_PUBLIC_ prefix is required so the client
# bundle can read it too — a DSN isn't secret, it's designed to ship in
# client code. Unset/empty disables the SDK rather than erroring.
NEXT_PUBLIC_SENTRY_DSN=
